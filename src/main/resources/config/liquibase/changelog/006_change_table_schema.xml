<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="add column jhi_user to commission_target_yn" author="sniper">
    <addColumn tableName="jhi_user">
      <column name="commission_target_yn" type="boolean" valueBoolean="false" remarks="커미션 지급 대상 여부"/>
      <column name="discount_accept_yn" type="boolean" valueBoolean="false" remarks="커미션 할인 가능 여부"/>
      <column name="model_no" type="varchar(60)" remarks="모델 번호"/>
    </addColumn>
    <rollback>
      <dropColumn tableName="jhi_user" columnName="commission_target_yn"/>
      <dropColumn tableName="jhi_user" columnName="discount_accept_yn"/>
      <dropColumn tableName="jhi_user" columnName="model_no"/>
    </rollback>
  </changeSet>

  <changeSet id="modify init jhi_user" author="sniper">
    <sql>
      update jhi_user set model_no = 'TEST01', commission_target_yn = true, discount_accept_yn = false where login = 'admin';
      update jhi_user set model_no = 'TEST02', commission_target_yn = true, discount_accept_yn = true where login = 'user';
    </sql>
  </changeSet>

  <changeSet id="add column jhi_shop_order to sales refund price" author="sniper">
    <addColumn tableName="jhi_shop_order">
      <column name="discount_price" type="int" valueNumeric="0" remarks="할인 금액"/>
      <column name="refund_price" type="int" valueNumeric="0" remarks="환불 금액"/>
    </addColumn>
    <rollback>
      <dropColumn tableName="jhi_shop_order" columnName="discount_price"/>
      <dropColumn tableName="jhi_shop_order" columnName="refund_price"/>
    </rollback>
  </changeSet>
</databaseChangeLog>
